# Run package lifecycle scripts (preinstall/install/postinstall) serially in the
# foreground instead of concurrently. This monorepo pulls several esbuild major
# versions (0.18/0.25/0.27/0.28), each with its own @esbuild/<platform> native
# binary. esbuild's postinstall self-check execs that binary with no ETXTBSY
# retry (node_modules/esbuild/install.js validateBinaryVersion), so concurrent
# postinstalls race: one execs a native binary while another reify worker still
# holds it open for write -> "ETXTBSY: text file busy". Serializing install
# scripts removes the race for every CI workflow and local install.
foreground-scripts=true
