apps/control-plane-worker/.dev.vars
apps/control-plane-worker/.wrangler/
bundled-e2b-smoke/

# Tunnel signal file (written by scripts/dev-tunnel.sh)
.tunnel-url

# Stray egress-log test artifact (test now writes to the OS temp dir)
.tmp-egress-log-test/

# ngrok agent log (written by scripts/dev-tunnel.sh, kept for post-mortem)
.ngrok.log

# Worktree port assignments (written by scripts/worktree-setup.sh)
.worktree-ports
.cycloid-cli.json
.cycloid-local-token

# Local git worktrees
.worktrees/

# Shared npm cache (written by scripts/worktree-setup.sh)
.npm-cache/

# Claude worktrees (local agent workspace)
.claude/worktrees/

# Local SSL certs (generated by scripts/setup-ssl-certs.sh)
certs/

# Research/task docs (local scratch work)
research/
tasks/
.scratch/

.DS_Store
playwright-report/
.playwright-cli/
test-results/

# Python bytecode cache
__pycache__/
*.py[cod]

# Per-user local Codex config. The committed source of truth is
# .codex/config.example.toml; each dev seeds .codex/config.toml from it.
# Keeping the runtime file out of git prevents it from leaking into Cycloid
# sandboxes (which clone the repo) and conflicting with the bridge's MCP setup.
.codex/config.toml

# Personal daily Slack recaps written by the slack-daily-recap skill.
.slack-recaps/
