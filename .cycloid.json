{
  "verify": {
    "fix": {
      "command": "bash scripts/fix-changed-files.sh",
      "timeoutSeconds": 600
    },
    "test": {
      "commands": ["npm run format:check", "npm run typecheck", "npm run test:changed"],
      "timeoutSeconds": 600
    }
  },
  "appRuntime": {
    "kind": "web",
    "runner": "docker",
    "entry": {
      "type": "compose",
      "files": ["docker-compose.yml"],
      "service": "ui"
    },
    "generatedComposeEnv": {
      "DOGFOOD_SESSION_TOKEN": {
        "type": "hex",
        "bytes": 32
      }
    },
    "url": {
      "hostPort": 5173,
      "path": "/"
    },
    "additionalPorts": [
      {
        "service": "api",
        "hostPort": 3000,
        "containerPort": 3000
      }
    ],
    "ready": {
      "path": "/auth/status",
      "timeoutSeconds": 240
    },
    "open": {
      "path": "/"
    },
    "auth": {
      "command": "npm run cycloid:auth",
      "validatePath": "/api/bootstrap"
    },
    "e2e": {
      "testCommand": "npm run -w cycloid-ui test"
    }
  }
}
