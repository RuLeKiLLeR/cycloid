   "locked": false,
   "link": null,
   "opacity": 100,
   "angle": 0,
   "frameId": null,
   "roundness": null,
   "boundElements": [],
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "index": "b0w",
   "originalText": "Two intentional waits ONLY (\u00a715 inv 6):\n(a) CI-settled before epoch-1 \u2014 no-review cohort only (v8)\n(b) first-contact no-show window \u2014 binds only on a silent bot (v8)\nEverything else is eager: no cron tick, no CI re-confirm between epochs.",
   "autoResize": true
  },
