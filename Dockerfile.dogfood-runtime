# Dogfood runtime image for Cycloid-on-Cycloid previews.
#
# The source tree is bind-mounted by docker-compose.yml so verifier edits can be
# picked up by Vite/Wrangler without rebuilding this image. Dependencies live in
# Compose-managed node_modules volumes.
FROM node:22-bookworm-slim

WORKDIR /workspace/repo

# The root workspace includes native test dependencies such as better-sqlite3.
# The preview image needs the normal node-gyp toolchain for `npm ci`.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    python3 \
  && rm -rf /var/lib/apt/lists/*

ENV HOST=0.0.0.0

CMD ["bash"]
